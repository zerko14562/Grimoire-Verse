/* ============ STATE ============ */
let progress = { xp: 0, streak: 0, lastDate: null, completed: {}, lang: 'fr' };
let session = null;

const pathContainer = document.getElementById('pathContainer');
const overlay = document.getElementById('overlay');
const lessonBody = document.getElementById('lessonBody');
const progressFill = document.getElementById('progressFill');
const heartsDisplay = document.getElementById('heartsDisplay');
const streakVal = document.getElementById('streakVal');
const xpVal = document.getElementById('xpVal');
const brandName = document.getElementById('brandName');
const introTitle = document.getElementById('introTitle');
const introSub = document.getElementById('introSub');
const langSelect = document.getElementById('langSelect');
const resetBtn = document.getElementById('resetBtn');

function L(){ return progress.lang; }
function t(field){ if(field==null) return ''; return field[L()] || field.en || field.fr || ''; }
function ui(key, ...args){ const u = UI[L()] || UI.fr; const v = u[key]; return typeof v === 'function' ? v(...args) : v; }

function todayStr(){
  const d = new Date();
  return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();
}

const STORAGE_KEY = 'verse-primer-progress';
const hasClaudeStorage = (typeof window.storage !== 'undefined' && window.storage);

async function storageGet(){
  if(hasClaudeStorage){
    try{ const res = await window.storage.get(STORAGE_KEY, false); return res ? res.value : null; }
    catch(e){ return null; }
  }
  try{ return window.localStorage.getItem(STORAGE_KEY); }
  catch(e){ return null; }
}
async function storageSet(value){
  if(hasClaudeStorage){
    try{ await window.storage.set(STORAGE_KEY, value, false); return true; }
    catch(e){ console.error('Erreur de sauvegarde (window.storage)', e); return false; }
  }
  try{ window.localStorage.setItem(STORAGE_KEY, value); return true; }
  catch(e){ console.error('Erreur de sauvegarde (localStorage)', e); return false; }
}

async function loadProgress(){
  try{
    const raw = await storageGet();
    if(raw){ progress = Object.assign({xp:0,streak:0,lastDate:null,completed:{},lang:'fr'}, JSON.parse(raw)); }
  }catch(e){ /* première visite */ }

  const today = todayStr();
  if(progress.lastDate !== today){
    const y = new Date(); y.setDate(y.getDate()-1);
    const yStr = y.getFullYear()+'-'+(y.getMonth()+1)+'-'+y.getDate();
    progress.streak = (progress.lastDate === yStr) ? (progress.streak||0) + 1 : 1;
    progress.lastDate = today;
    await saveProgress();
  }
  renderAll();
}
async function saveProgress(){ await storageSet(JSON.stringify(progress)); }

function renderAll(){
  renderStats();
  renderLangSelect();
  renderStaticText();
  renderPath();
}
function renderStats(){ streakVal.textContent = progress.streak || 0; xpVal.textContent = progress.xp || 0; }
function renderStaticText(){
  document.documentElement.lang = L();
  brandName.textContent = ui('brand');
  introTitle.textContent = ui('introTitle');
  introSub.textContent = ui('introSub');
  resetBtn.title = ui('resetLabel');
}
function renderLangSelect(){
  langSelect.innerHTML = LANGS.map(l => `<option value="${l.code}" ${l.code===L()?'selected':''}>${l.name}</option>`).join('');
  langSelect.onchange = async ()=>{
    progress.lang = langSelect.value;
    await saveProgress();
    renderAll();
    if(session && overlay.classList.contains('active')){ renderStage(); }
  };
}

async function resetProgress(){
  if(!window.confirm(ui('resetConfirm'))) return;
  progress = { xp: 0, streak: 1, lastDate: todayStr(), completed: {}, lang: progress.lang };
  await saveProgress();
  renderAll();
}
resetBtn.addEventListener('click', resetProgress);

/* ============ PATH SCREEN ============ */
function renderPath(){
  pathContainer.innerHTML = '';
  UNITS.forEach((unit, i) => {
    const unlocked = i === 0 || progress.completed[UNITS[i-1].id];
    const done = !!progress.completed[unit.id];
    const row = document.createElement('div');
    row.className = 'unit-row ' + (i % 2 === 0 ? 'left' : 'right');
    row.innerHTML = `
      <div class="unit-card">
        <button class="hex-btn ${done ? 'done' : ''} ${!unlocked ? 'locked' : ''}" data-idx="${i}" ${!unlocked ? 'disabled' : ''}>
          ${done ? '✓' : (unlocked ? unit.num : '🔒')}
        </button>
        <div class="unit-label">
          <div class="name">${t(unit.title)}</div>
          <div class="sub">${t(unit.subtitle)}</div>
        </div>
      </div>`;
    pathContainer.appendChild(row);
  });
  pathContainer.querySelectorAll('.hex-btn:not(.locked)').forEach(btn=>{
    btn.addEventListener('click', ()=> startLesson(parseInt(btn.dataset.idx)));
  });
}

/* ============ LESSON FLOW ============ */
function startLesson(unitIndex){
  session = { unitIndex, exIndex: 0, hearts: 5, correctCount: 0, stage: 'intro' };
  overlay.classList.add('active');
  renderStage();
}
function closeLesson(){
  overlay.classList.remove('active');
  session = null;
  renderPath();
}
document.getElementById('closeBtn').addEventListener('click', closeLesson);

function renderStage(){
  const footer = document.querySelector('.lesson-footer');
  if(footer) footer.remove();
  if(session.stage === 'intro') return renderIntro();
  if(session.stage === 'exercise') return renderExercise();
}

function renderIntro(){
  const unit = UNITS[session.unitIndex];
  progressFill.style.width = '0%';
  heartsDisplay.innerHTML = Array.from({length:5}).map(()=> '❤️').join('');
  lessonBody.innerHTML = `
    <div class="card">
      <div class="eyebrow">${ui('lessonTag')} · ${t(unit.title)}</div>
      <div class="prompt">${t(unit.title)}</div>
      <div class="lesson-explain">${t(unit.lesson)}</div>
      <div class="codeblock">${escapeHtml(t(unit.lessonCode))}</div>
    </div>`;
  setFooterReady(true, ()=>{ session.stage = 'exercise'; session.exIndex = 0; renderStage(); });
  document.getElementById('footerBtn').textContent = ui('startExercises');
}

function updateHeader(){
  const unit = UNITS[session.unitIndex];
  const pct = Math.round((session.exIndex / unit.exercises.length) * 100);
  progressFill.style.width = pct + '%';
  heartsDisplay.innerHTML = Array.from({length:5}).map((_,i)=>
    i < session.hearts ? '❤️' : '🖤'
  ).join('');
}

function renderExercise(){
  const unit = UNITS[session.unitIndex];
  if(session.exIndex >= unit.exercises.length){ return renderSummary(true); }
  if(session.hearts <= 0){ return renderSummary(false); }

  updateHeader();
  const ex = unit.exercises[session.exIndex];
  session.answered = false;

  let codeHtml = '';
  if(ex.type === 'mcq' && ex.code){
    codeHtml = `<div class="codeblock">${escapeHtml(ex.code)}</div>`;
  }

  let bodyHtml = `
    <div class="card">
      <div class="eyebrow">${t(unit.title)} · ${session.exIndex+1}/${unit.exercises.length}</div>
      <div class="prompt">${t(ex.prompt)}</div>
      ${codeHtml}
  `;

  if(ex.type === 'mcq'){
    bodyHtml += `<div class="options" id="optionsWrap">`;
    t(ex.options).forEach((opt, i)=>{
      bodyHtml += `<button class="opt" data-idx="${i}">${escapeHtml(opt)}</button>`;
    });
    bodyHtml += `</div>`;
  } else if(ex.type === 'fill'){
    bodyHtml += `<div class="codeblock">${escapeHtml(ex.codeBefore)}<input type="text" class="blank-input" id="fillInput" placeholder="${t(ex.blankHint)}" autocomplete="off" spellcheck="false">${escapeHtml(ex.codeAfter)}</div>`;
  }

  bodyHtml += `<div class="feedback" id="feedback"></div></div>`;
  lessonBody.innerHTML = bodyHtml;

  if(ex.type === 'mcq'){
    let selected = null;
    document.querySelectorAll('.opt').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        if(session.answered) return;
        document.querySelectorAll('.opt').forEach(b=>b.classList.remove('selected'));
        btn.classList.add('selected');
        selected = parseInt(btn.dataset.idx);
        setFooterReady(true, ()=> checkMcq(ex, selected));
      });
    });
  } else if(ex.type === 'fill'){
    const input = document.getElementById('fillInput');
    input.addEventListener('input', ()=>{
      setFooterReady(input.value.trim().length > 0, ()=> checkFill(ex, input));
    });
    input.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter' && !session.answered && input.value.trim().length>0){ checkFill(ex, input); }
    });
    setTimeout(()=>input.focus(), 50);
  }
  setFooterReady(false);
  document.getElementById('footerBtn').textContent = ui('validate');
}

function setFooterReady(ready, onClick){
  let footer = document.querySelector('.lesson-footer');
  if(!footer){
    footer = document.createElement('div');
    footer.className = 'lesson-footer';
    footer.innerHTML = `<button class="btn-main" id="footerBtn">${ui('validate')}</button>`;
    lessonBody.parentElement.appendChild(footer);
  }
  const btn = document.getElementById('footerBtn');
  btn.disabled = !ready;
  btn.className = 'btn-main' + (ready ? ' ready' : '');
  btn.onclick = onClick || null;
}

function checkMcq(ex, selectedIdx){
  if(session.answered) return;
  session.answered = true;
  const correct = selectedIdx === ex.correct;
  document.querySelectorAll('.opt').forEach((b, i)=>{
    b.disabled = true;
    if(i === ex.correct) b.classList.add('correct');
    else if(i === selectedIdx) b.classList.add('incorrect');
  });
  showFeedback(correct, t(ex.explain));
}

function checkFill(ex, input){
  if(session.answered) return;
  session.answered = true;
  const val = input.value.trim().toLowerCase();
  const correct = ex.answers.some(a => a.trim().toLowerCase() === val);
  input.disabled = true;
  input.style.borderColor = correct ? 'var(--teal)' : 'var(--red)';
  showFeedback(correct, t(ex.explain), correct ? null : ex.answers[0]);
}

function showFeedback(correct, explain, correctAnswer){
  const fb = document.getElementById('feedback');
  fb.classList.add('show', correct ? 'correct' : 'incorrect');
  const headline = correct ? ui('exact') : (correctAnswer ? ui('almostPrefix') + correctAnswer : ui('notQuite'));
  fb.innerHTML = `<b>${headline}</b>${explain}`;

  if(correct){ session.correctCount++; progress.xp += 10; renderStats(); }
  else{ session.hearts--; updateHeader(); }

  setFooterReady(true, nextExercise);
  document.getElementById('footerBtn').textContent = ui('continue');
}

function nextExercise(){
  session.exIndex++;
  const footer = document.querySelector('.lesson-footer');
  if(footer) footer.remove();
  renderExercise();
}

async function renderSummary(success){
  const unit = UNITS[session.unitIndex];
  const footer = document.querySelector('.lesson-footer');
  if(footer) footer.remove();

  if(success){
    progress.completed[unit.id] = true;
    await saveProgress();
    lessonBody.innerHTML = `
      <div class="summary">
        <div class="big-mark">📜</div>
        <h2>${ui('lessonDone')}</h2>
        <p>${ui('lessonDoneDesc', t(unit.title))}</p>
        <div class="summary-stats">
          <div class="summary-stat"><div class="val">${session.correctCount}/${unit.exercises.length}</div><div class="lbl">${ui('correctLbl')}</div></div>
          <div class="summary-stat"><div class="val">+${session.correctCount*10}</div><div class="lbl">${ui('xpLbl')}</div></div>
          <div class="summary-stat"><div class="val">${session.hearts}</div><div class="lbl">${ui('livesLbl')}</div></div>
        </div>
      </div>`;
  } else {
    lessonBody.innerHTML = `
      <div class="summary">
        <div class="big-mark">💔</div>
        <h2>${ui('noLivesTitle')}</h2>
        <p>${ui('noLivesDesc')}</p>
      </div>`;
  }
  const footerDiv = document.createElement('div');
  footerDiv.className = 'lesson-footer';
  footerDiv.innerHTML = `<button class="btn-main ready" id="footerBtn">${success ? ui('backToPath') : ui('retry')}</button>`;
  lessonBody.parentElement.appendChild(footerDiv);
  document.getElementById('footerBtn').onclick = ()=>{
    if(success){ closeLesson(); }
    else{ startLesson(session.unitIndex); }
  };
}

function escapeHtml(str){
  return str.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
}

loadProgress();
</script>
</body>
