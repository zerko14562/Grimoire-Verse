<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grimoire Verse — Apprends Verse pour UEFN</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Sans+Devanagari:wght@400;500;700&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-deep: #120E1B;
    --bg-panel: #1C1730;
    --bg-panel-2: #241D3D;
    --line: #33294F;
    --gold: #E3B341;
    --gold-soft: rgba(227,179,65,0.14);
    --violet: #9C7CF4;
    --violet-soft: rgba(156,124,244,0.16);
    --teal: #2FBF9F;
    --teal-soft: rgba(47,191,159,0.14);
    --red: #F0665A;
    --red-soft: rgba(240,102,90,0.14);
    --text: #EDE9F7;
    --text-dim: #A99FC4;
    --text-faint: #6F6690;
    --font-display: 'Fraunces', serif;
    --font-body: 'Inter', 'Noto Sans JP', 'Noto Sans KR', 'Noto Sans Devanagari', sans-serif;
    --font-mono: 'Fira Code', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    background:
      radial-gradient(ellipse 900px 500px at 50% -10%, rgba(156,124,244,0.16), transparent 60%),
      radial-gradient(ellipse 700px 400px at 90% 100%, rgba(227,179,65,0.08), transparent 60%),
      var(--bg-deep);
    color: var(--text);
    font-family: var(--font-body);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{ background: var(--violet-soft); }
  button{ font-family: inherit; cursor:pointer; }
  button:focus-visible, input:focus-visible, select:focus-visible, .opt:focus-visible{
    outline: 2px solid var(--gold); outline-offset:2px;
  }

  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    max-width: 640px; margin: 0 auto; padding: 22px 20px 8px; gap:10px; flex-wrap:wrap;
  }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-mark{
    width:30px; height:30px;
    background: conic-gradient(from 210deg, var(--violet), var(--gold), var(--violet));
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    flex-shrink:0;
  }
  .brand-name{ font-family: var(--font-display); font-size:19px; font-weight:600; letter-spacing:0.2px;}
  .stats{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .stat{
    display:flex; align-items:center; gap:6px;
    font-weight:600; font-size:14px; color: var(--text-dim);
    background: var(--bg-panel); border:1px solid var(--line);
    padding: 6px 12px; border-radius: 999px;
  }
  .stat .flame{ color: var(--gold); }
  .stat .gem{ color: var(--violet); }
  #resetBtn{ font-size:16px; }
  .lang-select{
    background: var(--bg-panel); border:1px solid var(--line); color: var(--text);
    font-family: inherit; font-size:13px; font-weight:600; padding:7px 10px; border-radius:999px;
    -webkit-appearance:none; appearance:none; cursor:pointer;
  }

  .screen{ max-width: 640px; margin: 0 auto; padding: 10px 20px 80px; }
  .intro{ text-align:center; padding: 22px 10px 34px; }
  .intro h1{
    font-family: var(--font-display); font-weight:700; font-size: 28px;
    letter-spacing:0.2px; line-height:1.3; white-space:pre-line;
    background: linear-gradient(120deg, var(--text) 30%, var(--gold) 70%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .intro p{ color: var(--text-dim); font-size:14.5px; margin-top:8px; }

  .path{ position:relative; padding: 10px 0 20px; }
  .path::before{
    content:''; position:absolute; left:50%; top:20px; bottom:20px;
    width:2px; transform:translateX(-50%);
    background: repeating-linear-gradient(to bottom, var(--line) 0 8px, transparent 8px 16px);
  }
  .unit-row{ position:relative; display:flex; justify-content:center; margin: 26px 0; }
  .unit-row.left .unit-card{ transform: translateX(-92px); }
  .unit-row.right .unit-card{ transform: translateX(92px); }
  .unit-card{ display:flex; flex-direction:column; align-items:center; gap:10px; position:relative; z-index:2;}
  .hex-btn{
    width:84px; height:84px; border:none;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display:flex; align-items:center; justify-content:center;
    font-family: var(--font-display); font-weight:700; font-size:26px;
    background: linear-gradient(155deg, var(--violet), #6a4fc9);
    color: #fff; box-shadow: 0 8px 24px rgba(156,124,244,0.35);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .hex-btn:hover{ transform: scale(1.06); }
  .hex-btn:active{ transform: scale(0.97); }
  .hex-btn.done{ background: linear-gradient(155deg, var(--gold), #b8862b); box-shadow: 0 8px 24px rgba(227,179,65,0.35); }
  .hex-btn.locked{ background: var(--bg-panel-2); color: var(--text-faint); box-shadow:none; cursor:not-allowed; }
  .hex-btn.locked:hover{ transform:none; }
  .unit-label{ text-align:center; }
  .unit-label .name{ font-weight:600; font-size:14.5px; }
  .unit-label .sub{ font-size:12px; color: var(--text-faint); margin-top:2px; }

  .overlay{ position:fixed; inset:0; background: var(--bg-deep); display:none; flex-direction:column; z-index:50; }
  .overlay.active{ display:flex; }
  .lesson-top{ display:flex; align-items:center; gap:14px; padding: 18px 20px; border-bottom:1px solid var(--line); }
  .close-btn{ background:none; border:none; color: var(--text-faint); font-size:22px; line-height:1; padding:4px 8px; border-radius:8px; }
  .close-btn:hover{ color: var(--text); background: var(--bg-panel); }
  .progress-track{ flex:1; height:10px; background: var(--bg-panel); border-radius:999px; overflow:hidden; }
  .progress-fill{ height:100%; background: linear-gradient(90deg, var(--violet), var(--gold)); width:0%; transition: width .35s ease; }
  .hearts{ display:flex; gap:3px; font-size:16px; min-width:80px; justify-content:flex-end; }

  .lesson-body{ flex:1; overflow-y:auto; display:flex; justify-content:center; padding: 30px 20px 20px; }
  .card{ width:100%; max-width: 560px; }
  .eyebrow{ font-size:12.5px; letter-spacing:1.2px; text-transform:uppercase; color: var(--violet); font-weight:600; }
  .prompt{ font-family: var(--font-display); font-size:22px; font-weight:600; margin: 8px 0 22px; line-height:1.4; white-space:pre-line; }
  .lesson-explain{ font-size:15px; line-height:1.75; color: var(--text-dim); margin-bottom:22px; }

  .codeblock{
    background: #0F0B1A; border:1px solid var(--line); border-radius:12px;
    padding: 18px 20px; font-family: var(--font-mono); font-size:14.5px;
    color: #D8CFF0; line-height:1.8; white-space:pre-wrap; margin-bottom:22px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }
  .blank-input{
    background: var(--bg-panel-2); border:1.5px solid var(--violet);
    color: var(--text); font-family: var(--font-mono); font-size:14.5px;
    padding: 3px 10px; border-radius:6px; width: 120px; text-align:center;
  }

  .options{ display:flex; flex-direction:column; gap:10px; }
  .opt{
    text-align:left; background: var(--bg-panel); border:1.5px solid var(--line);
    color: var(--text); padding: 14px 16px; border-radius:12px;
    font-family: var(--font-mono); font-size:14.5px;
    transition: border-color .15s ease, background .15s ease;
  }
  .opt:hover{ border-color: var(--violet); }
  .opt.selected{ border-color: var(--violet); background: var(--violet-soft); }
  .opt.correct{ border-color: var(--teal); background: var(--teal-soft); }
  .opt.incorrect{ border-color: var(--red); background: var(--red-soft); }
  .opt:disabled{ cursor:default; }

  .feedback{ margin-top:18px; padding:14px 16px; border-radius:12px; font-size:14px; line-height:1.5; display:none; }
  .feedback.show{ display:block; }
  .feedback.correct{ background: var(--teal-soft); border:1px solid rgba(47,191,159,0.4); color:#BFF3E7; }
  .feedback.incorrect{ background: var(--red-soft); border:1px solid rgba(240,102,90,0.4); color:#FAD2CE; }
  .feedback b{ display:block; margin-bottom:3px; font-family: var(--font-display); font-size:14.5px; }

  .lesson-footer{ padding: 16px 20px 24px; display:flex; justify-content:center; border-top:1px solid var(--line); }
  .btn-main{
    width:100%; max-width:560px; padding:15px; border:none; border-radius:14px;
    background: var(--bg-panel-2); color: var(--text-faint); font-weight:700; font-size:15px;
    letter-spacing:0.3px; transition: all .15s ease;
  }
  .btn-main.ready{ background: linear-gradient(90deg, var(--gold), #d4a53a); color:#251a05; box-shadow: 0 6px 18px rgba(227,179,65,0.3);}
  .btn-main:disabled{ cursor:not-allowed; }

  .summary{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding: 20px; }
  .summary .big-mark{ font-size:64px; margin-bottom:12px; }
  .summary h2{ font-family: var(--font-display); font-size:26px; font-weight:700; }
  .summary p{ color: var(--text-dim); margin-top:8px; max-width:380px; }
  .summary-stats{ display:flex; gap:18px; margin-top:24px; flex-wrap:wrap; justify-content:center; }
  .summary-stat{ background: var(--bg-panel); border:1px solid var(--line); border-radius:14px; padding: 14px 22px; min-width:90px; }
  .summary-stat .val{ font-family: var(--font-display); font-size:22px; font-weight:700; color: var(--gold); }
  .summary-stat .lbl{ font-size:11.5px; color: var(--text-faint); text-transform:uppercase; letter-spacing:0.5px; margin-top:2px; }

  @media (max-width: 460px){
    .unit-row.left .unit-card, .unit-row.right .unit-card{ transform: translateX(0); }
    .path::before{ display:none; }
    .prompt{ font-size:19px; }
  }
</style>
</head>
<body>

  <div class="topbar">
    <div class="brand">
      <div class="brand-mark"></div>
